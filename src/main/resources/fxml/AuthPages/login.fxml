<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.valek.controller.AuthControllers.LoginController"
            prefWidth="900" prefHeight="600"
            style="-fx-background-color: #f3f7ff;">

    <left>
        <VBox alignment="CENTER" spacing="20"
              prefWidth="280"
              style="-fx-background-color: linear-gradient(to bottom, #e2eeff, #c9dcff);"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets top="30" bottom="30" left="22" right="22"/>
            </padding>

            <Label text="📘" style="-fx-font-size: 58px;"/>

            <Label text="English Learning Platform"
                   wrapText="true"
                   alignment="CENTER"
                   style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #163779;"
                   maxWidth="240"/>

            <Label text="Учите английский удобно и эффективно"
                   wrapText="true"
                   alignment="CENTER"
                   style="-fx-font-size: 15px; -fx-text-fill: #5473a8;"
                   maxWidth="220"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="🇬🇧  Learn something new every day!"
                   wrapText="true"
                   alignment="CENTER"
                   style="-fx-font-size: 14px; -fx-text-fill: #244b91;"/>

        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" spacing="18">

            <padding>
                <Insets top="30" bottom="30" left="45" right="45"/>
            </padding>

            <VBox spacing="10" maxWidth="390"
                  style="-fx-background-color: white; -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, #cbd8eb, 18, 0.15, 0, 5);">

                <padding>
                    <Insets top="35" bottom="35" left="32" right="32"/>
                </padding>

                <Label text="Вход в аккаунт"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #163779;"/>

                <Label text="Рады снова вас видеть!"
                       style="-fx-font-size: 15px; -fx-text-fill: #7185a8;"/>

                <Region minHeight="8"/>

                <TextField fx:id="emailField"
                           promptText="Email или имя пользователя"
                           prefHeight="44"
                           style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #d6e1f2; -fx-font-size: 14px;"/>

                <PasswordField fx:id="passwordField"
                               promptText="Пароль"
                               prefHeight="44"
                               style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #d6e1f2; -fx-font-size: 14px;"/>

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <CheckBox fx:id="rememberMeCheckBox"
                              text="Запомнить меня"
                              style="-fx-text-fill: #35517d;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Hyperlink text="Забыли пароль?"
                               onAction="#handleForgotPassword"
                               style="-fx-text-fill: #2875f5;"/>
                </HBox>

                <Label fx:id="messageLabel"
                       text=""
                       wrapText="true"
                       style="-fx-text-fill: #d64545;"/>

                <Button text="Войти"
                        onAction="#handleLogin"
                        maxWidth="Infinity"
                        prefHeight="46"
                        style="-fx-background-color: #3478f6; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 9; -fx-cursor: hand;"/>

                <HBox alignment="CENTER" spacing="12">
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="или"
                           style="-fx-text-fill: #7c8eac;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <Button text="Продолжить без входа"
                        onAction="#handleGuest"
                        maxWidth="Infinity"
                        prefHeight="42"
                        style="-fx-background-color: white; -fx-text-fill: #244b91; -fx-border-color: #d6e1f2; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 14px; -fx-cursor: hand;"/>

                <Region minHeight="12"/>

                <HBox alignment="CENTER" spacing="5">
                    <Label text="Нет аккаунта?"
                           style="-fx-text-fill: #7185a8;"/>

                    <Hyperlink text="Зарегистрироваться"
                               onAction="#handleOpenRegister"
                               style="-fx-text-fill: #2875f5; -fx-font-weight: bold;"/>
                </HBox>

            </VBox>
        </VBox>
    </center>

</BorderPane>
